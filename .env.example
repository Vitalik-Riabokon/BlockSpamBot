BOT_TOKEN=replace_with_your_token

# General runtime
# TEST_MODE=0
# TUNNEL_NOTIFY_ENABLED=1
# TUNNEL_NOTIFY_USER_ID=410477852

# Local WebApp server
# WEBAPP_HOST=127.0.0.1
# WEBAPP_PORT=8080

# Tunnel / public WebApp URL
# In normal flow the bot uses the current tunnel URL from
# main/data/tunnel_notifier_state.json.
# WEBAPP_BASE_URL=https://your-public-domain
# CLOUDFLARED_AUTO_START=1
# CLOUDFLARED_BIN=cloudflared
# CLOUDFLARED_TARGET_URL=http://127.0.0.1:8080
# TUNNEL_LOG_PATH=main/data/cloudflared.out.log
# TUNNEL_LOG_POLL_SECONDS=1.0
# BOT_LOCK_PATH=main/data/bot.lock

# Moderation thresholds
# SUSPECT_SCORE_THRESHOLD=45
# BLOCK_SCORE_THRESHOLD=75
# SUSPECT_ESCALATION_COUNT=3
# SUSPECT_WINDOW_SECONDS=604800

# Spam / flood heuristics
# WINDOW_SECONDS=120
# FLOOD_COUNT=4
# DUPLICATE_WINDOW_SECONDS=600
# SPLIT_WINDOW_SECONDS=120
# SPLIT_MAX_MESSAGES=4
# AD_DUPLICATE_BLOCK_WINDOW_SECONDS=300
# AD_DUPLICATE_BLOCK_COUNT=3
